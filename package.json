{
  "name": "cadence",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run tests/calendar.test.ts",
    "tauri": "tauri",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --lib",
    "test:ui": "playwright test",
    "format": "prettier --write src tests *.json *.ts *.js"
  },
  "dependencies": {
    "@fontsource/barlow": "^5",
    "@fontsource/barlow-condensed": "^5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "svelte": "^5"
  },
  "devDependencies": {
    "@playwright/test": "^1",
    "@sveltejs/vite-plugin-svelte": "^6",
    "@tauri-apps/cli": "^2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^5.0.5"
  }
}
