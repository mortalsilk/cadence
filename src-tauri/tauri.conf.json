{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cadence",
  "version": "0.2.1",
  "identifier": "io.cadence.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "cadence",
        "width": 380,
        "height": 620,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true,
        "maximizable": false,
        "transparent": true,
        "backgroundColor": "#17191b00"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Local stint and session tracker",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "linux": {
      "deb": {}
    },
    "longDescription": "cadence records standalone stints and timed sessions locally, with editable history, daily activity, and local backups."
  }
}
